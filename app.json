{
  "expo": {
    "name": "Bigkas",
    "slug": "bigkas",
    "scheme": "bigkas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": false
    },

    "android": {
      "permissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.otheseussorganization.bigkas",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#410FA3"
      }
    },

    "plugins": [
      "expo-router",
      "expo-speech-recognition",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#410FA3"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Bigkas to access your microphone to check pronunciation and tone."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "3abfa83d-6bca-48d1-8a49-bea26c4e8976"
      }
    },

    "owner": "otheseuss-organization"
  }
}
